<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <RootNamespace>Turn_One_Link</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Content\app_icon.ico</ApplicationIcon>

        <!-- The one place the version lives: shown in the UI, sent as clientVersion, used by the installer. -->
        <Version>1.2.0</Version>
        <Product>Turn One Link</Product>
        <Company>Turn One</Company>

        <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
        <StartupObject>Turn_One_Link.Program</StartupObject>

        <!-- Single-file publish must carry WPF's native DLLs (wpfgfx, PresentationNative, ...) inside the exe. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotNetEnv" Version="3.2.0" />
      <PackageReference Include="IRSDKSharper" Version="1.1.10" />
      <PackageReference Include="QRCoder" Version="1.8.0" />
      <PackageReference Include="Sentry" Version="6.12.1" />
      <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>

    <!-- Crash reporting is off unless the build passes -p:SentryDsn=... (CI does, from a secret). -->
    <ItemGroup>
      <AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" />
    </ItemGroup>

    <!-- The test project lives inside this folder; keep its files out of the app. -->
    <ItemGroup>
      <Compile Remove="tests\**" />
      <EmbeddedResource Remove="tests\**" />
      <None Remove="tests\**" />
      <Page Remove="tests\**" />
    </ItemGroup>

    <!-- Developer .env files are only read by Debug builds (App.xaml.cs) and never published. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <None Update=".env">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update=".env.local">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Content\logo mic.png" />
      <Resource Include="Content\logo32.png" />
      <Resource Include="Content\logo bigger margins t1.png" />
      <Resource Include="Content\app_icon.ico" />
    </ItemGroup>

    <!-- Phone dashboard served by the LAN server (LF-17) -->
    <ItemGroup>
      <EmbeddedResource Include="Content\phone-dash.html" LogicalName="Turn_One_Link.Content.phone-dash.html" />
    </ItemGroup>

</Project>
